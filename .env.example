# ============================================================================
# Nasdaq & SEC Regulatory Compliance Agentic RAG — Environment Configuration
# ============================================================================

# LLM Provider: "auto" (default), "gemini", "openai", "groq", or "offline"
# In "auto" mode, the system uses Gemini/OpenAI/Groq if an API key is provided,
# and automatically falls back to the Deterministic Institutional Engine when offline.
LLM_PROVIDER=auto

# Optional LLM API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector Database Configuration
# Use ":memory:" for zero-setup embedded Qdrant, or "http://localhost:6333" for Qdrant Server
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=nasdaq_sec_regulatory_corpus
